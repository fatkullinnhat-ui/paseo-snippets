{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022"],
    "types": ["node", "react", "react-native"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true
  },
  "include": ["index.client.tsx", "index.server.ts", "client/**/*.ts", "client/**/*.tsx", "server/**/*.ts", "shared/**/*.ts", "tests/**/*.ts"]
}
